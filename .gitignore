*.jpeg
*.gif
*.pdf
*.dae
*.obj
*.stl
*.log
*.out
*.err
*.bak*
*.csv
*.jsonl
*.mjpeg
nohup.out

# ...except the small ones a fresh clone needs to fly the films' deciders and the camera model
!/shared/px4_gazebo/cam_B.npy
!/shared/px4_gazebo/cam_to_ned.npy
!/shared/fast_sim/rl_corridor_eyes_lidar_gps_birds_hunter_rig_v2l_s0_mean.pt
!/shared/fast_sim/clone_corridor.pt
!/shared/px4_gazebo/gz_logan/rig_v2/yolo/run/
!/shared/px4_gazebo/gz_logan/rig_v2/yolo/run/weights/
!/shared/px4_gazebo/gz_logan/rig_v2/yolo/run/weights/best.pt
!/shared/px4_gazebo/gz_logan/rig_v2/yolo/run_geo/
!/shared/px4_gazebo/gz_logan/rig_v2/yolo/run_geo/weights/
!/shared/px4_gazebo/gz_logan/rig_v2/yolo/run_geo/weights/best.pt
!/papers/docs/figures/*.png
# four wind checkpoints (0.6 MB each): the two the old README names, the paper's decider and its frozen flyer (render.py's default).
# The old exceptions sat BEFORE "*.npz" above, so they never worked (git check-ignore); here they come after it.
!/conditions/wind/runs/fly_hp_s0_best.npz
!/conditions/wind/runs/stage2_c100_s0_best.npz
!/conditions/wind/runs/stage2_c100h100g_s0_best.npz
!/conditions/wind/runs/fly_s0_best.npz
# 26 KB GeoAnchor error pool; urban_env.py and every PX4 mission load it, a fresh clone cannot run the fast sim without it
!/shared/fast_sim/sigma_pool.npz

