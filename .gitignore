# rl-landing: code, configs, docs and the few small checkpoints the films need go in git.
# Everything a run produces, every dataset, and ALL Esri Wayback imagery (and anything rendered over it:
# films, stills, texture tiles) stays out -- Esri's terms: measurement use only, never published.

# ---- experiment outputs: ONE folder. Every run folder, log, film, scratch output and PX4 working dir lives in outputs/ ----
# (replaces /gazebo_*/ /px4run*/ /runs*/ /v2*/ /v3*/ /v4_phys/ /v5/ /v6/ /cage_*/ /ctrl_*/ /sweep*/ /final*/ /match*/ /fused/
#  /sv2/ /truesig/ /rep/ /qual/ /chan/ /rho08/ /out_*/ /overnight/ /weather_*/ /media/ /weights/ /geo/runs/ /geo/missions/
#  /urban/eyes_drift/ /urban/first_try/ /urban/from_scratch/ /queue/*.log /queue/*.out /queue/*.done)
/outputs/

# ---- generated or snapshot folders that still sit inside a unit ----
/papers/deck/project/
/papers/report/*
!/papers/report/build_report.py
# the report builder's template was untracked, so a fresh clone could not rebuild the report (strike.jpg stays out: provenance unknown)
!/papers/report/rig_report.template.html
/papers/paper/*
!/papers/paper/build_figures.py
# the Tello cage's untracked outputs (cage_fig.json, cage_rl_*.json); flights/ and train.log now go to outputs/
/archive/tello/*.json
# fly.py falls back to it when layout.json is absent
!/archive/tello/layout_example.json
/conditions/wind/runs/*
!/conditions/wind/runs/*.json

# ---- the Logan world's generated assets and datasets (rebuilt by the scripts; see README) -----------------
/shared/px4_gazebo/gz_logan/imagery/
/shared/px4_gazebo/gz_logan/photo/
/shared/px4_gazebo/gz_logan/birds/
/shared/px4_gazebo/gz_logan/*/materials/
/shared/px4_gazebo/gz_logan/*/meshes/
/shared/px4_gazebo/gz_logan/models/logan_*/
/shared/px4_gazebo/gz_logan/rig*/data*/
/shared/px4_gazebo/gz_logan/rig*/cover*/
/shared/px4_gazebo/gz_logan/rig*/yolo/ds*/
/shared/px4_gazebo/gz_logan/rig*/yolo/ds*.yaml
/shared/px4_gazebo/gz_logan/rig*/yolo/*.pt
/shared/px4_gazebo/gz_logan/*/prop_mask*
/shared/px4_gazebo/gz_logan/**/gz.log

# ---- binaries, media, logs ------------------------------------------------------------------------------------
*.zip
*.tif
*.tiff
*.mp4
*.webm
*.avi
*.ulg
*.ckpt
*.pt
*.pth
*.onnx
*.npz
*.npy
*.png
