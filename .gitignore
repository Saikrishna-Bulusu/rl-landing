# rl-landing: code, configs, docs and the few small checkpoints the films need go in git.
# Everything a run produces, every dataset, and ALL Esri Wayback imagery (and anything rendered over it:
# films, stills, texture tiles) stays out -- Esri's terms: measurement use only, never published.

# ---- experiment outputs: one folder per run or sweep ------------------------------------------------------
/gazebo_*/
/px4run*/
/runs*/
/v2*/
/v3*/
/v4_phys/
/v5/
/v6/
/cage_*/
/ctrl_*/
/sweep*/
/final*/
/match*/
/fused/
/sv2/
/truesig/
/rep/
/qual/
/chan/
/rho08/
/out_*/
/overnight/
/weather_*/
/media/
/weights/
/deck/
/report/*
!/report/build_report.py
/paper/*
!/paper/build_figures.py
/tello/*
!/tello/*.py
/urban/eyes_drift/
/urban/first_try/
/urban/from_scratch/
/wind/runs/*
!/wind/runs/*.json
!/wind/runs/fly_hp_s0_best.npz
!/wind/runs/stage2_c100_s0_best.npz
/geo/runs/
/geo/missions/
/queue/*.log
/queue/*.out
/queue/*.done

