    <include><uri>model://logan_pad_11</uri><name>logan_pad_11</name><pose>109.00 -82.00 0.001 0 0 0</pose></include>
    <include><uri>model://logan_pad_12</uri><name>logan_pad_12</name><pose>88.00 -78.00 0.001 0 0 0</pose></include>
    <include><uri>model://logan_pad_13</uri><name>logan_pad_13</name><pose>103.00 83.00 0.001 0 0 0</pose></include>
    <include><uri>model://logan_pad_14</uri><name>logan_pad_14</name><pose>75.00 -73.00 0.001 0 0 0</pose></include>
    <include><uri>model://logan_pad_15</uri><name>logan_pad_15</name><pose>63.00 -66.00 0.001 0 0 0</pose></include>
    <model name='magpie'><static>true</static><link name='link'><visual name='body'><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><ellipsoid><radii>0.2 0.06 0.06</radii></ellipsoid></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual><visual name='head'><pose>0.2 0 0.03 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><sphere><radius>0.05</radius></sphere></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual><visual name='wings'><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.14 0.8 0.015</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual><visual name='patches'><pose>-0.02 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.08 0.5 0.017</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual><visual name='tail'><pose>-0.26 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.16 0.08 0.01</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>
