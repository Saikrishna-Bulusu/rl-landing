<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="aruco">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.62 0.76 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1200 1200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.42 0.22 1</ambient>
            <diffuse>0.34 0.48 0.25 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <include>
      <uri>model://arucotag</uri>
      <!-- 20 m north of the x500 spawn. With the tag AT the spawn the aircraft
           decoded it during the climb and jumped straight to centring, so the
           transit and search phases -- the whole point of the mission -- never
           ran. -->
      <pose>120 0 0.001 0 0 0</pose>
    </include>

    <!-- Overhead observer camera. Not part of the aircraft: it exists only so
         a mission can be recorded to video. 45 m up, looking straight down,
         90 deg FOV -> a 90 m square footprint, which covers the largest
         GeoAnchor error in the pool (34 m) with room to spare. -->
    
    <include><uri>model://logan_roads</uri><pose>0 0 0 0 0 0</pose></include>
    <include><uri>model://logan_buildings</uri><pose>0 0 0 0 0 0</pose></include>
    <include><uri>model://logan_trees</uri><pose>0 0 0 0 0 0</pose></include>
    <include><uri>model://logan_pad_1</uri><name>logan_pad_1</name><pose>126.00 -9.00 0.001 0 0 0</pose></include>
